<div class="col-sm">
    <div class="card">
      <h5 class="card-header">
        TFP state
        <button type="button"  class="btn btn-dark btn-sm float-right" {{on "click" this.editForm}} >Edit</button>
      </h5>
      <div class="card-body">
        <p>
            <form>
                <div class="form-group row">
                    <label for="tfpState.UVC1BlisterNbHour" class="col-sm col-form-label">UVC1 Blister number hours</label>
                    <div class="col-sm">
                        <Input readonly={{this.formIsNotEdited}} id="tfpState.UVC1BlisterNbHour" class="form-control" @type="text" @value={{this.state.UVC1BlisterNbHour}} />
                    </div>
                </div>
                <div class="form-group row">
                    <label for="tfpState.UVC2BlisterMbHour" class="col-sm col-form-label">UVC2 Blister number hours</label>
                    <div class="col-sm">
                        <Input readonly={{this.formIsNotEdited}} id="tfpState.UVC2BlisterNbHour" class="form-control" @type="text" @value={{this.state.UVC2BlisterNbHour}} />
                    </div>
                </div>
                <div class="form-group row">
                    <label for="tfpState.ozoneBlisterNbHour" class="col-sm col-form-label">Ozone Blister number hours</label>
                    <div class="col-sm">
                        <Input readonly={{this.formIsNotEdited}} id="tfpState.ozoneBlisterNbHour" class="form-control" @type="text" @value={{this.state.ozoneBlisterNbHour}} />
                    </div>
                </div>
                {{#unless this.formIsNotEdited}}
                <button type="submit" class="btn btn-primary" {{on "click" this.save}} >Save</button>
                {{/unless}}
            </form>
            {{#each this.config.errors as |error|}}
              <div class="text-danger">{{error.message}}</div>
            {{/each}}
        </p>
      </div>
    </div>
</div>