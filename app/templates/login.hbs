<div class="col-sm">
<form {{on 'submit' this.authenticate}}>
  <div class="form-group">
    <label for="username">
      Login
    </label>
    <Input id="username" @value={{this.username}} class="form-control" placeholder="Enter username" />
  </div>

  <div class="form-group">
    <label for="password">
      Password
    </label>
    <Input id="password" @type="password" @value={{this.password}} class="form-control" placeholder="Enter password" />
  </div>
  <button type="submit" class="btn btn-primary">
    Login
  </button>
  {{#if this.errorMessage}}
    <p class="text-danger">{{this.errorMessage}}</p>
  {{/if}}
</form>
</div>