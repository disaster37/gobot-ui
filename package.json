{
  "name": "dfp-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pond/aquarium automation dashboard (Nuxt v4 + Nuxt UI v4)",
  "license": "MIT",
  "scripts": {
    "dev": "nuxt dev --port 4200",
    "build": "nuxt generate",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "clean": "rm -rf .nuxt .output dist coverage",
    "postinstall": "nuxt prepare",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@iconify-json/bi": "^1.2.0",
    "@iconify-json/lucide": "^1.2.0",
    "@nuxt/ui": "^4.0.0",
    "@pinia/nuxt": "^0.11.0",
    "dayjs": "^1.11.13",
    "nuxt": "^4.0.0",
    "pinia": "^3.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.0.0",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.51.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.0.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "24"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "anymatch": {
      "picomatch": "^2.3.2"
    }
  }
}
